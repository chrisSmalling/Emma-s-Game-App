{
  "expo": {
    "name": "Little Counter",
    "slug": "little-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emmagame.littlecounter"
    },
    "android": {
      "package": "com.emmagame.littlecounter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B98D5"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Little Counter",
      "shortName": "Counter",
      "themeColor": "#1B98D5",
      "backgroundColor": "#7FD8F7"
    }
  }
}
